        },
        {
          "c": "          C         F          C           G7",
          "l": "Tänk alla dagar jag vandrat så sorgsen och trött"
        },
        {
          "c": "        Am       F         G7                  C",
          "l": "för att möta den vackraste människa jag nånsin mött"
        }
      ]
    },
    {
      "label": "Vers 3",
      "lines": [
        {
          "c": "          C         F           G7",
          "l": "Det finns ingen som lockat mitt hjärta så underbart"
        },
        {
          "c": "            C                     F          Dm    G7",
          "l": "Med all din ömhet får du sorg och smärta att sakta försvinna"
        },
        {
          "c": "     C            F          G7",
          "l": "Alla skuggor allt mörker som förr var så uppenbart"
        },
        {
          "c": "             C                      F          G7                C",
          "l": "Det skingras och tillsammans ser vi ljuset som stiger med solens fart"
        }
      ]
    },
