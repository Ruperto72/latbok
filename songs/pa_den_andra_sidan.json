{
  "title": "På Den Andra Sidan",
  "artist": "Lars Demian",
  "key": "D",
  "timeSignature": "4/4",
  "difficulty": "Medel",
  "chordTemplates": {},
  "sections": [
    {
      "label": "Intro",
      "lines": [
        {
          "c": "G  D  G  C",
          "l": ""
        },
        {
          "c": "G  D  G  G",
          "l": ""
        },
        {
          "c": "      D             G",
          "l": "Här slutar jag min resa"
        },
        {
          "c": "     Em             C     D",
          "l": "På gränsen till ett annat land"
        },
        {
          "c": "     B",
          "l": "Jag känner mig så trött"
        },
        {
          "c": "    Em           C",
          "l": "Så sliten och så nött"
        },
        {
          "c": "             G       D              G",
          "l": "Men jag ser ljus på flodens andra strand"
        },
        {
          "c": "G            D   G             G",
          "l": "Där får jag vila, där får jag frid"
        },
        {
          "c": "             Em         C      D",
          "l": "Där kan jag glömma min trötta kropp"
        },
        {
          "c": "B",
          "l": "Dagen syns ej mer"
        },
        {
          "c": "Em              C",
          "l": "Snart går solen ner"
        },
        {
          "c": "       G            D             G",
          "l": "Men på andra sidan floden går den opp"
        },
        {
          "c": "G  D  G  C",
          "l": ""
        },
        {
          "c": "G  D  G  G",
          "l": ""
        },
        {
          "c": "G     D       G           G",
          "l": "Kära kamrater, spara era tårar"
        },
        {
          "c": "Em      C       D",
          "l": "Ingen gråt min vän"
        },
        {
          "c": "        B",
          "l": "Det är inte nå Adieu"
        },
        {
          "c": "           Em           C",
          "l": "Det finns inget som kan dö"
        },
        {
          "c": "        G         D        G",
          "l": "Det är farväl vi ses snart igen"
        },
        {
          "c": "G                     D",
          "l": "Så drick ett glas för mig"
        },
        {
          "c": "        G",
          "l": "Höj en skål för all vår kärlek"
        },
        {
          "c": "         Em     C        D",
          "l": "Låt mitt minne sorglöst förbli"
        },
        {
          "c": "        B",
          "l": "Det är inget ont som sker"
        },
        {
          "c": "    Em           C",
          "l": "Låt Livet trösta er"
        },
        {
          "c": "   G           D               G",
          "l": "På andra sidan floden blir jag fri"
        },
        {
          "c": "G  D  G  G",
          "l": ""
        },
        {
          "c": "Em C  D  D",
          "l": ""
        },
        {
          "c": "B  B  Em C",
          "l": ""
        },
        {
          "c": "G  D  G  G",
          "l": ""
        },
        {
          "c": "G   D              G",
          "l": "Framför mig slutar vägen"
        },
        {
          "c": "     Em              C      D",
          "l": "Över mörkret går en lysande bro"
        },
        {
          "c": "         B",
          "l": "Jag har varit här förut"
        },
        {
          "c": "        Em              C",
          "l": "Jag har kommit hem till slut"
        },
        {
          "c": "       G            D              G",
          "l": "Här på andra sidan floden vill jag bo"
        },
        {
          "c": "G  D  G  C",
          "l": ""
        },
        {
          "c": "G  D  G  G",
          "l": ""
        }
      ]
    }
  ]
}