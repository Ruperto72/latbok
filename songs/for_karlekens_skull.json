        }
      ]
    },
    {
      "label": "vers 1",
      "lines": [
        {
          "c": "Dm7     G7            C     F",
          "l": "Utanför fönstret slår våren ut."
        },
        {
          "c": "Dm7        G7sus4  G7 C",
          "l": "Marken blir grön   i- gen."
        },
        {
          "c": "Dm7          E7               Am    Am/G",
          "l": "Allt som var dött, väcks till liv,"
        },
        {
          "c": "              Fmaj7     F6",
          "l": "det kan också vi   Mm.."
        },
        {
          "c": "            G7sus4   G7",
          "l": "Så länge vi andas."
        }
      ]
    },
    {
      "label": "vers 2",
      "lines": [
        {
          "c": "Dm7      G7           C     Fmaj7",
          "l": "Ute till havs styr en fiskebåt."
        },
        {
          "c": "Dm7          G7sus4 G7  Cmaj7",
          "l": "Längs en fri hor -  i - sont."
        },
        {
          "c": "Dm7           E7            Am     Am/G",
          "l": "Den gungar så tryggt in mot hamn"
        },
        {
          "c": "              Fmaj7       F6",
          "l": "som jag i din famn.   Mm.."
        },
        {
          "c": "            G7sus4  G7",
          "l": "Så länge vi älskar."
        }
      ]
    },
    {
      "label": "Refräng",
      "lines": [
        {
          "c": "C   G/B    Am   Em/G      F",
          "l": "Det är för oss  solen går opp."
        },
        {
          "c": "F  C/E     Dm7       G6 G7     C",
          "l": "Ly-ser som guld, för kärlekens skull"
        },
        {
          "c": "C  G/B     Am   Em/G      F",
          "l": "So-len går upp, så oskuldsfull"
        },
        {
          "c": "F  C/E    Dm7     G6 G7     C",
          "l": "Ly-ser på oss för kärlekens skull."
        }
      ]
    },
    {
      "label": "vers 3",
      "lines": [
        {
          "c": "Dm7         G7           C     F",
          "l": "Högt på ett berg står en katedral,"
        },
        {
          "c": "Dm7       G7sus4 G7   C",
          "l": "och pekar upp    mot  skyn."
        },
        {
          "c": "Dm7           E7        Am    Am/G",
          "l": "Men det är för himlen i dig,"
        },
        {
          "c": "             Fmaj7    F6",
          "l": "och jorden i mig...Mm.."
        },
        {
          "c": "          G7sus4   G7",
          "l": "Vi älskar varandra."
        }
      ]
    },
    {
      "label": "Refräng 2",
      "lines": [
        {
          "c": "C   G/B    Am   Em/G      F",
          "l": "Det är för oss  solen går opp."
