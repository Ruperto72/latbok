{
  "title": "Trubaduren",
  "artist": "Ruben Nilson / Gunnar Turesson",
  "key": "C",
  "timeSignature": "4/4",
  "difficulty": "Lätt",
  "chordTemplates": {
  },
  "sections": [
    {
      "label": "Vers 1",
      "lines": [
        {
          "c": "   C           F            C",
          "l": "Grevinnan hon satt vid ett fönster"
        },
		{
          "c": "     Dm         G      C",
          "l": "Hon satt i sin jungfrubur"
        },
		{
          "c": "   Am",
          "l": "I nattrock med gyllene mönster"
        },
		{
          "c": "    Dm          G        C",
          "l": "Då kom där en glad trubadur"
        },
		{
          "c": "     Dm          G       C",
          "l": "Kom in här och spela en visa!"
        },
		{
          "c": "     Dm        G        C",
          "l": "Min man är i främmande land."
        },
		{
          "c": "      Dm           G             C",
          "l": "Din skönhet, min fru, vill jag prisa"
        },
		{
          "c": "       Dm            G         C",
          "l": "Om du ger mig ditt hjärta och hand."
        }
      ]
    },
    {
      "label": "Vers 2",
      "lines": [
        {
          "c": "    C           F        C",
          "l": "Grevinnan hon vred sina händer"
        },
		{
          "c": "     Dm           G          C",
          "l": "Min man , han är borta, min vän"
        },
		{
          "c": "      Am",
          "l": "Han krigar i främmande länder"
        },
		{
          "c": "     Dm        G        C",
          "l": "Och kommer väl aldrig igen"
        },
		{
          "c": "    Dm           G       C",
          "l": "Kom in här och spela en visa!"
        },
		{
          "c": "    Dm         G          C",
          "l": "Så sorgsen jag är i mitt sinn."
        },
		{
          "c": "      Dm           G             C",
          "l": "Din skönhet, min fru, vill jag prisa"
        },
		{
          "c": "     Dm           G       C",
          "l": "Sa' sångarn och klättrade in"
        }
      ]
    },
    {
      "label": "Vers 3",
      "lines": [
        {
          "c": "      C         F         C",
          "l": "Han knäppte på lutan och sade:"
        },
		{
          "c": "      Dm           G         C",
          "l": "Ack, ge mig ditt hjärta och hand."
        },
		{
          "c": "     Am",
          "l": "Och runt omkring livet hon hade"
        },
		{
          "c": "     Dm         G    C",
          "l": "Ett ronsenrött sidenband"
        },
		{
          "c": "     Dm          G        C",
          "l": "Det tog hon och gav trubaduren"
        },
		{
          "c": "     Dm       G     C",
          "l": "Att sätta på lutan sin"
        },
		{
          "c": "    Dm          G        C",
          "l": "Då hördes det steg i tamburen"
        },
		{
          "c": "      Dm           G    C",
          "l": "Och greven själv trädde in"
        }
      ]
    },
    {
      "label": "Vers 4",
      "lines": [
        {
          "c": "      C           F          C",
          "l": "Och greven han skramla med svärdet"
        },
		{
          "c": "       Dm        G            C",
          "l": "Och skratta ett vansinnigt skratt"
        },
		{
          "c": "     Am",
          "l": "Och sade: Min sköna, hur är det?"
        },
		{
          "c": "     Dm      G          C",
          "l": "Min nådiga, hur är det fatt?"
        },
		{
          "c": "     Dm         G     C",
          "l": "Vem fan är den där figuren"
        },
		{
          "c": "     Dm           G      C",
          "l": "Vad gör han vid grevens härd?"
        },
		{
          "c": "        Dm          G     C",
          "l": "Och han pekade på trubaduren"
        },
		{
          "c": "      Dm           G          C",
          "l": "Med sitt långa, blodiga svärd"
        }
      ]
    },
    {
      "label": "Vers 5",
      "lines": [
        {
          "c": "   C            F         C",
          "l": "Grevinnan, som nyss hade dånat"
        },
		{
          "c": "     Dm         G        C",
          "l": "Hon sade: -Det är ju en narr"
        },
		{
          "c": "    Am",
          "l": "Och alldeles nyss har han lånat"
        },
		{
          "c": "     Dm            G       C",
          "l": "Ett band till sin gamla gitarr."
        },
		{
          "c": "     Dm        G         C",
          "l": "Det där låter fasen så troligt"
        },
		{
          "c": "       Dm        G         C",
          "l": "Sade greven och mönstrade dem"
        },
		{
          "c": "     Dm           G        C",
          "l": "-O, Rickard!, sa hon, -så roligt!"
        },
		{
          "c": "    Dm         G        C",
          "l": "Så roligt att du - kom hem."
        }
      ]
    },
    {
      "label": "Vers 6",
      "lines": [
        {
          "c": "    C        F          C",
          "l": "Å, jaså, förlåt lilla flickan"
        },
		{
          "c": "      Dm          G          C",
          "l": "Sa' greven och strök hennes kind"
        },
		{
          "c": "      Am",
          "l": "Men trubaduren han gick han"
        },
		{
          "c": "     Dm        G        C",
          "l": "Och hängde sig oppe på vind"
        },
		{
          "c": "     Dm       G       C",
          "l": "Och liksom av änglar buren"
        },
		{
          "c": "         Dm      G       C",
          "l": "Till ett annat, sällare land"
        },
		{
          "c": "      Dm          G  C",
          "l": "Där svävade trubaduren"
        },
		{
          "c": "       Dm        G    C",
          "l": "I ett rosenrött sidenband"
        }
      ]
    }
  ]
}
